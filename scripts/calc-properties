#!/usr/bin/env python3

import argparse
import bisect
import json
import math
import random
import sys


# A 100-value sample normally narrows an order statistic substantially in one
# count pass. Budgeting 16 KiB per cell conservatively covers its Python objects.
MEDIAN_SAMPLE_SIZE = 100
MEDIAN_BYTES_PER_CELL = 16 * 1024


class PropertyAccumulator:
    # Track the common sample shape and streaming moments across chains.
    def __init__(self):
        self.property_names = None
        self.sequence_names = None
        self.sequence_lengths = None
        self.means = None
        self.m2s = None
        self.counts = None
        self.retained_samples = 0

    # Allocate streaming moment state for each property and sequence character.
    def _initialize(self, cat_states, properties):
        self.property_names = tuple(sorted(properties))
        self.sequence_names = tuple(sorted(cat_states))
        self.sequence_lengths = {
            name: len(cat_states[name]) for name in self.sequence_names
        }
        self.means = {
            property_name: {
                name: [0.0] * self.sequence_lengths[name]
                for name in self.sequence_names
            }
            for property_name in self.property_names
        }
        self.m2s = {
            property_name: {
                name: [0.0] * self.sequence_lengths[name]
                for name in self.sequence_names
            }
            for property_name in self.property_names
        }
        self.counts = {
            property_name: {
                name: [0] * self.sequence_lengths[name]
                for name in self.sequence_names
            }
            for property_name in self.property_names
        }

    # Ensure every retained sample describes the same properties and characters.
    def _validate_shape(self, cat_states, properties, context):
        property_names = tuple(sorted(properties))
        if property_names != self.property_names:
            raise ValueError(
                f"{context}: property names changed; expected "
                f"{list(self.property_names)}, got {list(property_names)}"
            )

        sequence_names = tuple(sorted(cat_states))
        if sequence_names != self.sequence_names:
            raise ValueError(
                f"{context}: sequence names changed; expected "
                f"{list(self.sequence_names)}, got {list(sequence_names)}"
            )

        for name in self.sequence_names:
            length = len(cat_states[name])
            expected = self.sequence_lengths[name]
            if length != expected:
                raise ValueError(
                    f"{context}: sequence '{name}' length changed; "
                    f"expected {expected} characters, got {length}"
                )

    # Validate each component-state table before any values are accumulated.
    def _validate_property_tables(self, properties, context):
        for property_name, components in properties.items():
            if not isinstance(property_name, str):
                raise ValueError(f"{context}: property names must be strings")
            if not isinstance(components, list):
                raise ValueError(
                    f"{context}: property '{property_name}' must contain a list "
                    "of component tables"
                )

            for component_index, states in enumerate(components):
                if not isinstance(states, list):
                    raise ValueError(
                        f"{context}: property '{property_name}' component "
                        f"{component_index} must contain a list of state values"
                    )
                for state_index, value in enumerate(states):
                    if (
                        isinstance(value, bool)
                        or not isinstance(value, (int, float))
                        or not math.isfinite(value)
                    ):
                        raise ValueError(
                            f"{context}: property '{property_name}' component "
                            f"{component_index} state {state_index} must be finite"
                        )

    # Resolve a validated character state against one property's sampled table.
    def _property_value(
        self,
        properties,
        property_name,
        component_index,
        state_index,
        character_context,
    ):
        components = properties[property_name]
        if component_index >= len(components):
            raise ValueError(
                f"{character_context}: property '{property_name}' has no component "
                f"{component_index}"
            )
        if state_index >= len(components[component_index]):
            raise ValueError(
                f"{character_context}: property '{property_name}' component "
                f"{component_index} has no state {state_index}"
            )
        return float(components[component_index][state_index])

    # Validate and add one retained sample without storing the sample itself.
    def add_sample(self, sample, context):
        cat_states = sample.get("catStates")
        properties = sample.get("properties")
        if not isinstance(cat_states, dict):
            raise ValueError(f"{context}: 'catStates' must be an object")
        if not cat_states:
            raise ValueError(f"{context}: 'catStates' must contain a sequence")
        if not isinstance(properties, dict):
            raise ValueError(f"{context}: 'properties' must be an object")

        for name, states in cat_states.items():
            if not isinstance(name, str):
                raise ValueError(f"{context}: sequence names must be strings")
            if not isinstance(states, list):
                raise ValueError(
                    f"{context}: sequence '{name}' category states must be a list"
                )

        self._validate_property_tables(properties, context)
        if self.property_names is None:
            self._initialize(cat_states, properties)
        else:
            self._validate_shape(cat_states, properties, context)

        for name in self.sequence_names:
            for character_index, pair in enumerate(cat_states[name]):
                if pair is None:
                    continue

                character_context = (
                    f"{context}: sequence '{name}' character {character_index}"
                )
                if not isinstance(pair, list) or len(pair) != 2:
                    raise ValueError(
                        f"{character_context}: category-state value must be "
                        "null or a two-element list"
                    )
                component_index, state_index = pair
                if (
                    isinstance(component_index, bool)
                    or isinstance(state_index, bool)
                    or not isinstance(component_index, int)
                    or not isinstance(state_index, int)
                ):
                    raise ValueError(
                        f"{character_context}: category and state indices must be integers"
                    )
                if component_index < 0 or state_index < 0:
                    raise ValueError(
                        f"{character_context}: category and state indices must be non-negative"
                    )

                for property_name in self.property_names:
                    value = self._property_value(
                        properties,
                        property_name,
                        component_index,
                        state_index,
                        character_context,
                    )
                    counts = self.counts[property_name][name]
                    means = self.means[property_name][name]
                    m2s = self.m2s[property_name][name]

                    # Welford's recurrence accumulates the centered second moment
                    # without subtracting two potentially large squared values.
                    count = counts[character_index] + 1
                    delta = value - means[character_index]
                    means[character_index] += delta / count
                    delta2 = value - means[character_index]
                    m2s[character_index] += delta * delta2
                    counts[character_index] = count

        self.retained_samples += 1

    # Convert the streaming moments into posterior summaries and count matrices.
    def result(self, selection, retained_samples_by_chain, medians):
        summaries = {}
        for property_name in self.property_names:
            means = {}
            standard_deviations = {}
            for name in self.sequence_names:
                means[name] = [
                    mean if count else None
                    for mean, count in zip(
                        self.means[property_name][name],
                        self.counts[property_name][name],
                    )
                ]
                standard_deviations[name] = [
                    math.sqrt(max(m2 / count, 0.0)) if count else None
                    for m2, count in zip(
                        self.m2s[property_name][name],
                        self.counts[property_name][name],
                    )
                ]
            summaries[property_name] = {
                "mean": means,
                "sd": standard_deviations,
                "median": medians[property_name],
                "count": self.counts[property_name],
            }

        return {
            "format": "bali-phy-character-properties",
            "version": 1,
            "coordinates": {
                "kind": "ungapped-sequence-character",
                "index_base": 0,
            },
            "selection": selection,
            "retained_samples": self.retained_samples,
            "retained_samples_by_chain": retained_samples_by_chain,
            "properties": summaries,
        }


class MedianCell:
    # Initialize the exact order statistic within an initially unbounded interval.
    def __init__(self, count):
        self.lower = None
        self.upper = None
        self.active_count = count
        self.target_rank = (count - 1) // 2 if count else None
        self.result = None
        self.done = count == 0
        self.positions = None
        self.position_index = None
        self.samples = None
        self.pivots = None
        self.bucket_counts = None
        self.observed_count = None

    # Select active-stream positions before scanning, avoiding per-value RNG work.
    def start_sampling(self, generator):
        sample_size = min(MEDIAN_SAMPLE_SIZE, self.active_count)
        self.positions = sorted(generator.sample(range(self.active_count), sample_size))
        self.position_index = 0
        self.samples = []
        self.observed_count = 0

    # Retain a value exactly when its active-stream position was selected.
    def observe_sample(self, value):
        if (
            (self.lower is not None and value <= self.lower)
            or (self.upper is not None and value >= self.upper)
        ):
            return
        if (
            self.position_index < len(self.positions)
            and self.observed_count == self.positions[self.position_index]
        ):
            self.samples.append(value)
            self.position_index += 1
        self.observed_count += 1

    # Resolve a small cell directly or retain unique sampled values as pivots.
    def finish_sampling(self):
        if self.observed_count != self.active_count:
            raise ValueError("property samples changed while computing medians")
        if len(self.samples) != len(self.positions):
            raise ValueError("property samples changed while computing medians")

        self.positions = None
        self.position_index = None
        if self.active_count <= MEDIAN_SAMPLE_SIZE:
            self.samples.sort()
            self.result = self.samples[self.target_rank]
            self.done = True
            self.samples = None
            return

        self.pivots = sorted(set(self.samples))
        self.samples = None

    # Allocate alternating open-interval and pivot-equality buckets.
    def start_counting(self):
        self.bucket_counts = [0] * (2 * len(self.pivots) + 1)
        self.observed_count = 0

    # Place an active value in its ordered interval or pivot-equality bucket.
    def observe_count(self, value):
        if (
            (self.lower is not None and value <= self.lower)
            or (self.upper is not None and value >= self.upper)
        ):
            return

        pivot_index = bisect.bisect_left(self.pivots, value)
        if pivot_index < len(self.pivots) and self.pivots[pivot_index] == value:
            bucket_index = 2 * pivot_index + 1
        else:
            bucket_index = 2 * pivot_index
        self.bucket_counts[bucket_index] += 1
        self.observed_count += 1

    # Resolve a pivot rank or narrow the search while preserving its relative rank.
    def finish_counting(self):
        if self.observed_count != self.active_count:
            raise ValueError("property samples changed while computing medians")

        # These buckets partition the active values in sorted order. The bucket
        # containing the target therefore either resolves it or preserves it
        # inside a smaller open interval after subtracting preceding counts.
        preceding = 0
        for bucket_index, count in enumerate(self.bucket_counts):
            if self.target_rank >= preceding + count:
                preceding += count
                continue

            if bucket_index % 2:
                self.result = self.pivots[bucket_index // 2]
                self.done = True
            else:
                gap_index = bucket_index // 2
                if gap_index:
                    self.lower = self.pivots[gap_index - 1]
                if gap_index < len(self.pivots):
                    self.upper = self.pivots[gap_index]
                self.active_count = count
                self.target_rank -= preceding
            self.pivots = None
            self.bucket_counts = None
            return

        raise ValueError("could not locate the posterior median")


class MedianBlockAccumulator:
    # Visit unresolved cells in one character block during a sampling or counting pass.
    def __init__(self, characters, sampling):
        self.characters = [
            (
                name,
                character_index,
                tuple(
                    (property_name, cell)
                    for property_name, cell in property_cells
                    if not cell.done
                ),
            )
            for name, character_index, property_cells in characters
            if any(not cell.done for _property_name, cell in property_cells)
        ]
        self.sampling = sampling

    # Replay values already validated by the initial streaming-moments pass.
    def add_sample(self, sample, _context):
        cat_states = sample["catStates"]
        properties = sample["properties"]
        if self.sampling:
            observe = MedianCell.observe_sample
        else:
            observe = MedianCell.observe_count

        for name, character_index, property_cells in self.characters:
            pair = cat_states[name][character_index]
            if pair is None:
                continue
            component_index, state_index = pair
            for property_name, cell in property_cells:
                value = float(properties[property_name][component_index][state_index])
                observe(cell, value)


# Define the small public CLI and reject inconsistent selection arguments early.
def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description="Compute posterior property summaries for each sequence character."
    )
    parser.add_argument(
        "filenames",
        nargs="+",
        help="JSON Lines files containing sampled category states and properties",
    )
    parser.add_argument(
        "--skip",
        type=int,
        default=None,
        metavar="ITER",
        help="discard samples at or before iteration ITER",
    )
    parser.add_argument(
        "--until",
        type=int,
        default=None,
        metavar="ITER",
        help="discard samples after iteration ITER",
    )
    parser.add_argument(
        "--subsample",
        type=int,
        default=1,
        metavar="N",
        help="retain every Nth eligible sample in each chain",
    )
    parser.add_argument(
        "--median-memory",
        type=int,
        default=256,
        metavar="MIB",
        help="target MIB of working memory for exact median calculation",
    )
    args = parser.parse_args(argv)

    if args.skip is not None and args.skip < 0:
        parser.error("--skip must be non-negative")
    if args.until is not None and args.until < 0:
        parser.error("--until must be non-negative")
    if args.subsample <= 0:
        parser.error("--subsample must be positive")
    if args.median_memory <= 0:
        parser.error("--median-memory must be positive")
    if (
        args.skip is not None
        and args.until is not None
        and args.until <= args.skip
    ):
        parser.error("--until must be greater than --skip")
    return args


# Decode one non-empty JSON Lines record and attach its source to parse errors.
def decode_sample(line, context):
    if not line.strip():
        raise ValueError(f"{context}: empty JSON line")
    try:
        sample = json.loads(line)
    except json.JSONDecodeError as error:
        raise ValueError(f"{context}: invalid JSON: {error.msg}") from None
    if not isinstance(sample, dict):
        raise ValueError(f"{context}: sample must be a JSON object")
    return sample


# Stream one chain, applying iteration bounds and stride independently.
def accumulate_chain(filename, args, accumulator):
    previous_iteration = None
    eligible_samples = 0
    retained_samples = 0

    with open(filename, encoding="utf-8") as json_lines:
        for line_number, line in enumerate(json_lines, start=1):
            context = f"{filename}:{line_number}"
            sample = decode_sample(line, context)
            iteration = sample.get("iter")
            if isinstance(iteration, bool) or not isinstance(iteration, int):
                raise ValueError(f"{context}: 'iter' must be an integer")
            if iteration < 0:
                raise ValueError(f"{context}: 'iter' must be non-negative")
            if previous_iteration is not None and iteration <= previous_iteration:
                raise ValueError(
                    f"{context}: iterations must increase strictly; got {iteration} "
                    f"after {previous_iteration}"
                )
            previous_iteration = iteration

            if args.until is not None and iteration > args.until:
                break
            if args.skip is not None and iteration <= args.skip:
                continue

            retain = eligible_samples % args.subsample == 0
            eligible_samples += 1
            if not retain:
                continue

            accumulator.add_sample(sample, context)
            retained_samples += 1

    if retained_samples == 0:
        raise ValueError(f"{filename}: no samples remain after selection")
    return retained_samples


# Replay every selected chain and detect changes between summary passes.
def run_median_pass(args, accumulator, retained_samples_by_chain):
    replayed_samples_by_chain = [
        accumulate_chain(filename, args, accumulator) for filename in args.filenames
    ]
    if replayed_samples_by_chain != retained_samples_by_chain:
        raise ValueError("property sample files changed while computing medians")


# Compute exact lower medians in memory-bounded blocks of sequence characters.
def calculate_medians(args, moments, retained_samples_by_chain):
    medians = {
        property_name: {
            name: [None] * moments.sequence_lengths[name]
            for name in moments.sequence_names
        }
        for property_name in moments.property_names
    }
    if not moments.property_names:
        return medians

    coordinates = [
        (name, character_index)
        for name in moments.sequence_names
        for character_index in range(moments.sequence_lengths[name])
    ]
    budget_bytes = args.median_memory * 1024 * 1024
    cells_per_block = max(1, budget_bytes // MEDIAN_BYTES_PER_CELL)
    characters_per_block = max(1, cells_per_block // len(moments.property_names))

    # Pivot randomness changes only the number of passes, so fix its seed to make
    # resource use reproducible without affecting the exact answer.
    generator = random.Random(0)

    for block_start in range(0, len(coordinates), characters_per_block):
        characters = []
        cells = []
        block_coordinates = coordinates[
            block_start : block_start + characters_per_block
        ]
        for name, character_index in block_coordinates:
            property_cells = []
            for property_name in moments.property_names:
                count = moments.counts[property_name][name][character_index]
                cell = MedianCell(count)
                property_cells.append((property_name, cell))
                cells.append((property_name, name, character_index, cell))
            characters.append((name, character_index, property_cells))

        while any(not cell.done for _property_name, _name, _character_index, cell in cells):
            for _property_name, _name, _character_index, cell in cells:
                if not cell.done:
                    cell.start_sampling(generator)
            run_median_pass(
                args,
                MedianBlockAccumulator(characters, sampling=True),
                retained_samples_by_chain,
            )
            for _property_name, _name, _character_index, cell in cells:
                if not cell.done:
                    cell.finish_sampling()

            unresolved = [
                cell
                for _property_name, _name, _character_index, cell in cells
                if not cell.done
            ]
            if not unresolved:
                break
            for cell in unresolved:
                cell.start_counting()
            run_median_pass(
                args,
                MedianBlockAccumulator(characters, sampling=False),
                retained_samples_by_chain,
            )
            for cell in unresolved:
                cell.finish_counting()

        for property_name, name, character_index, cell in cells:
            medians[property_name][name][character_index] = cell.result

    return medians


# Combine selected records from all chains and construct the summary document.
def calculate_summary(args):
    accumulator = PropertyAccumulator()
    retained_samples_by_chain = [
        accumulate_chain(filename, args, accumulator) for filename in args.filenames
    ]
    selection = {
        "skip": args.skip,
        "until": args.until,
        "subsample": args.subsample,
    }
    medians = calculate_medians(args, accumulator, retained_samples_by_chain)
    return accumulator.result(selection, retained_samples_by_chain, medians)


# Report validation and I/O failures without exposing implementation tracebacks.
def main(argv=None):
    args = parse_args(argv)
    try:
        summary = calculate_summary(args)
        json.dump(
            summary,
            sys.stdout,
            allow_nan=False,
            separators=(",", ":"),
            sort_keys=True,
        )
        print()
    except (OSError, ValueError) as error:
        print(f"calc-properties: Error! {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
