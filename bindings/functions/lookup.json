{
    "name": "lookup",
    "result_type": "a",
    "no_log": true,
    "call": "(IntMap.!)(@m,@i)",
    "import": ["qualified Data.IntMap as IntMap"],
    "args": [
        {
            "name": "m",
            "type": "IntMap<a>",
            "description": "Integer-keyed map"
        },
        {
            "name": "i",
            "type": "Int",
            "description": "Key whose value is returned"
        }
    ],
    "title": "Look up an integer key",
    "description": "Return the value associated with key i in the integer-keyed map m. A missing key raises an error."
}
