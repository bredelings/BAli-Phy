{
    "name": "||",
    "fixity": {
        "associativity": "left",
        "precedence": 2
    },
    "result_type": "Bool",
    "no_log": true,
    "call": "@x || @y",
    "args": [
        {
            "name": "x",
            "type": "Bool"
        },
        {
            "name": "y",
            "type": "Bool"
        }
    ],
    "title": "Logical OR",
    "description": "Returns true if either x or y is true. The second argument is evaluated only when the first is false.",
    "examples": [
        "(2 > 3) || (3 < 4)"
    ],
    "see": [
        "&&"
    ]
}
