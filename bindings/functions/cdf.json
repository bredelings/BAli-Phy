{
    "name": "cdf",
    "result_type": "Double",
    "no_log": true,
    "call": "cdf(@dist,@x)",
    "import": ["Probability"],
    "args": [
        {
            "name": "dist",
            "type": "Distribution<Double>",
	    "description": "The distribution to evaluate"
        },
        {
            "name": "x",
            "type": "Double",
	    "description": "The upper threshold"
        }
    ],
    "title": "The cumulative distribution function",
    "examples": ["cdf(Gamma(1, 2), 1)"],
    "description": "Return Pr(X <= x) under dist.",
    "see": ["quantile", "pdf"]
}
