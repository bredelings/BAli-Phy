{
    "name": "cdf",
    "result_type": "Double",
    "no_log": true,
    "call": "cdf(@dist,@x)",
    "import": ["Probability"],
    "args": [
        {
            "name": "dist",
            "type": "Distribution<a>",
	    "description": "The distribution to evaluate"
        },
        {
            "name": "x",
            "type": "Double",
	    "description": "The upper threshold"
        }
    ],
    "title": "The cumulative distribution function",
    "examples": ["cdf(Gamma(1, 2), 1)", "cdf(Poisson(1), 1/2)"],
    "description": "Return Pr(X <= x) under dist. The threshold may be fractional even when the distribution produces integers.",
    "see": ["quantile", "pdf"]
}
