{
    "name": "quantile",
    "result_type": "Double",
    "no_log": true,
    "call": "quantile(@dist,@p)",
    "import": ["Probability"],
    "args": [
        {
            "name": "dist",
            "type": "Distribution<Double>",
	    "description": "The distribution to evaluate"
        },
        {
            "name": "p",
            "type": "Double",
	    "description": "The cumulative probability, from 0 to 1"
        }
    ],
    "title": "The quantile function",
    "examples": ["quantile(Gamma(1, 2), 0.5)   # The median of Gamma(1,2)"],
    "description": "Return the quantile at probability p under dist: the point at which the cumulative probability reaches p. For example, p = 0.5 gives the median.",
    "see": ["cdf", "uniform_discretize"]
}
