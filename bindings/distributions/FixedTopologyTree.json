{
    "name": "FixedTopologyTree",
    "deprecated-synonyms": ["fixed_topology_tree"],
    "result_type": "Distribution<Tree<Lengths>>",
    "call": "fixedTopologyTree(@topology,@branchLengthDist)",
    "import": ["Probability"],
    "title": "The uniform_topology distribution on trees",
    "args": [
        {
            "name": "topology",
            "type": "Tree<Nothing>",
	    "description": "The topology for the tree"
        },
	{
	    "name": "branchLengthDist",
	    "type": "Distribution<Double>",
	    "description": "The distribution for branch lengths",
	    "default_value": "Gamma(0.5,2/num_branches(@topology))"
	}
    ]
}
