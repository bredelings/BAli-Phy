{
    "name": "Beta",
    "deprecated-synonyms": ["beta"],
    "result_type": "Distribution<Double>",
    "call": "beta(@a,@b)",
    "import": ["Probability"],
    "args": [
        {
            "name": "a",
            "type": "Double",
	    "description": "The a parameter"
        },
        {
            "name": "b",
            "type": "Double",
	    "description": "The b parameter"
        }
    ],
    "title": "The Beta distribution",
    "description": "The Beta distribution has mean a*b and variance\n a*b/((a+b)^2 * (a+b+1)).",
    "examples": ["~Beta(1,1)               // Sample from a Uniform(0,1)",
		 "~IID(10, Beta(1,1))       // Generate 10 uniform samples",
		 "density(Beta(3,4),0.5)   // Compute the Beta[3,4] density at 0.5"
		 ]
}
