{
    "name": "ShiftedGamma",
    "deprecated-synonyms": ["shifted_gamma"],
    "result_type": "Distribution<Double>",
    "call": "shifted_gamma(@a,@b,@shift)",
    "import": ["Probability"],
    "args": [
        {
            "name": "a",
            "type": "Double",
	    "description": "The shape parameter"
        },
        {
            "name": "b",
            "type": "Double",
	    "description": "The scale parameter"
        },
	{
	    "name": "shift",
	    "type": "Double",
	    "description": "The shift parameter"
	}
    ],
    "title" : "The gamma distribution",
    "description": "mean = a * b\nvariance = a*b^2",
    "examples": ["~ShiftedGamma(1.0, mu, 0)                   # An exponential",
		 "~ShiftedGamma(a, b, 1.5)                    # A Gamma shifted right by 1.5",
		 "~IID(10, ShiftedGamma(0.5, 2, 1.5))         # 10 samples",
		 "quantile(ShiftedGamma(0.5, 2, 0), 0.95)",
		 "density(ShiftedGamma(0.5, 2), 0.95)"
		],
    "see": ["Gamma"]
}
