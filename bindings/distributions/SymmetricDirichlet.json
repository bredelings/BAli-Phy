{
    "name": "SymmetricDirichlet",
    "deprecated-synonyms": [
        "symmetric_dirichlet"
    ],
    "result_type": "Distribution<List<Double>>",
    "call": "symmetricDirichlet(@n,@x)",
    "import": [
        "Probability"
    ],
    "args": [
        {
            "name": "n",
            "type": "Int",
            "description": "The number of categories"
        },
        {
            "name": "x",
            "type": "Double",
            "description": "The concentration per category"
        }
    ],
    "title": "The symmetric Dirichlet distribution",
    "examples": [
        "~SymmetricDirichlet(2,4)",
        "pdf(SymmetricDirichlet(2,4),[0.5,0.5])"
    ],
    "description": "Draws a list of n probabilities that sum to one, with the same concentration x for every category.",
    "see": [
        "Dirichlet",
        "SymmetricDirichletOn"
    ]
}
