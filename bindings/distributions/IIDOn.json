{
    "name": "IIDOn",
    "deprecated-synonyms": ["iid_on"],
    "result_type": "Distribution<Map<a,b>>",
    "constraints": ["Ord<a>"],
    "call": "iidOn(@xs,@dist)",
    "import": ["Probability"],
    "args": [
        {
            "name": "xs",
            "type": "Set<a>",
	    "description": "The keys identifying the samples"
        },
        {
            "name": "dist",
            "type": "Distribution<b>",
	    "description": "The distribution to sample from"
        }
    ],
    "title": "The Independent and Identically Distributed (i.i.d.) distribution",
    "examples": ["~IIDOn({1,2,3},Normal(0,1))    // A map of 3 Normal(0,1) random variables"]
}
