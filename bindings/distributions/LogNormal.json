{
    "name": "LogNormal",
    "deprecated-synonyms": ["logNormal"],
    "result_type": "Distribution<Double>",
    "call": "logNormal(@lmu,@lsigma)",
    "import": ["Probability"],
    "args": [
        {
            "name": "lmu",
            "type": "Double",
	    "description": "Mean of log(X)"
        },
        {
            "name": "lsigma",
            "type": "Double",
	    "description": "Standard deviation of log(X)"
        }
    ],
    "title": "The log-normal distribution",
    "examples": ["~LogNormal(0,1)","~IID(10, LogNormal(0,1))"],
    "description": "For X drawn from LogNormal(lmu,lsigma), log(X) is normally distributed with mean lmu and standard deviation lsigma. Thus X > 0 and its median is exp(lmu)."
}
