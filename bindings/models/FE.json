{
    "name": "FE",
    "deprecated-synonyms": ["fe"],
    "result_type": "CTMC<a>",
    "call": "plus_fe(@a,@submodel)",
    "import": ["SModel"],
    "args": [
        {
            "name": "submodel",
            "type": "ExchangeModel<a>",
	    "description": "The symmetric exchangeability matrix"
        },
        {
            "name": "a",
            "type": "a",
	    "default_value": "get_state(alphabet)",
	    "description": "The alphabet"
        }
    ],
    "title": "The +FE frequency model",
    "description": "Uses the +F frequency model with equal frequencies. Equivalent to +> F(pi=Frequencies.uniform).",
    "examples": ["WAG +> FE"],
    "extract": "all",
    "see": ["F","Frequencies.uniform"]
}
