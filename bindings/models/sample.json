{
    "name": "sample",
    "result_type": "a",
    "perform": true,
    "no_log": true,
    "call": "sample(@dist)",
    "import": ["Probability"],
    "args": [
        {
            "name": "dist",
            "type": "Distribution<a>",
            "description": "The distribution to sample from"
        }
    ],
    "title": "Draw from a distribution",
    "description": "Draw a value from dist. sample(dist) is equivalent to ~dist.",
    "examples": ["sample(UniformInt(1, 6))"]
}
