{
    "name": "F61",
    "deprecated-synonyms": ["f61"],
    "result_type": "Map<String,Double>",
    "constraints": ["Triplets<a,b>"],
    "call": "id(@pi)",
    "args": [
        {
            "name": "pi",
            "type": "Map<String,Double>",
            "default_value": "Map.fromList(~SymmetricDirichletOn(letters(@a),1.0))"
        },
        {
            "name": "a",
            "type": "a",
            "default_value": "get_state(alphabet)"
        }
    ],
    "extract": "all"
}
