{
    "name": "ASRV.LogNormal",
    "deprecated-synonyms": ["Rates.LogNormal", "Rates.logNormal"],
    "result_type": "DiscreteDist<CTMC<a>>",
    "call": "SModel.logNormalRates(@lsigma,@n,@submodel)",
    "import": ["SModel"],
    "args": [
        {
            "name": "submodel",
            "type": "DiscreteDist<CTMC<a>>",
            "description": "The model being scaled"
        },
        {
            "name": "n",
            "type": "Int",
            "default_value": "4",
            "description": "The number of quadrature nodes for the log-normal distribution"
        },
        {
            "name": "lsigma",
            "type": "Double",
            "description": "The standard deviation divided by the mean of the rate distribution",
            "default_value": "~LogLaplace(-3,1)"
        }
    ],
    "examples": ["GTR +> ASRV.LogNormal(4) +> Inv"]
}
