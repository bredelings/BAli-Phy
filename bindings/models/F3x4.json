{
    "name": "F3x4",
    "deprecated-synonyms": ["f3x4"],
    "result_type": "Map<String,Double>",
    "constraints": ["Triplets<a,b>"],
    "call": "f3x4'_frequencies(@a,@pi1,@pi2,@pi3)",
    "import": ["SModel"],
    "args": [
        {
            "name": "pi1",
            "type": "Map<String,Double>",
            "default_value": "~SymmetricDirichletOn(letters(getNucleotides(@a)),1.0)",
	    "description": "Nucleotide frequencies for position 1"
        },
        {
            "name": "pi2",
            "type": "Map<String,Double>",
            "default_value": "~SymmetricDirichletOn(letters(getNucleotides(@a)),1.0)",
	    "description": "Nucleotide frequencies for position 2"
        },
        {
            "name": "pi3",
            "type": "Map<String,Double>",
            "default_value": "~SymmetricDirichletOn(letters(getNucleotides(@a)),1.0)",
	    "description": "Nucleotide frequencies for position 3"
        },
        {
            "name": "a",
            "type": "a",
            "default_value":"get_state(alphabet)",
	    "description": "The triplet alphabet, including a codon alphabet"
        }
    ],
    "description": "Construct frequencies on a triplet alphabet, including a codon alphabet, from separate nucleotide frequencies for each position. The frequency of ijk is proportional to pi1[i]*pi2[j]*pi3[k]. Frequencies are normalized over the supplied alphabet; for codon alphabets, stop codons are excluded.",
    "examples": ["GY94(pi=F3x4)","F3x4(a=codons(DNA))"],
    "see": ["F1x4","GY94"],
    "extract": "all",
    "title": "F3x4 codon frequencies"
}
